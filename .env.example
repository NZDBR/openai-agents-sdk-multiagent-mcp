# TEMPLATE ONLY. Replace placeholders locally or bind through Databricks Apps/DAB.
DATABRICKS_HOST=https://<dev-workspace-host>
DATABRICKS_CONFIG_PROFILE=<databricks-profile>
# DATABRICKS_APP_NAME=<store-operations-app-name>  # injected by the deployed platform
USER_AUTHORIZATION_MODE=obo
ALLOW_LOCAL_PROFILE_IDENTITY=false
# Local CLI only: set USER_AUTHORIZATION_MODE=local_profile and ALLOW_LOCAL_PROFILE_IDENTITY=true.
MODEL_ENDPOINT=<model-serving-endpoint>
LAKEBASE_ENDPOINT=<lakebase-autoscaling-endpoint-resource-path>
STORE_OPS_SCHEMA=<lakebase-schema>
LAKEBASE_AGENT_MEMORY_SCHEMA=<lakebase-schema>
GENIE_SPACE_ID=<genie-space-id>
# Optional full native Genie URL; omit to derive it from DATABRICKS_HOST + GENIE_SPACE_ID.
# GENIE_MCP_URL=https://<workspace-host>/api/2.0/mcp/genie/<genie-space-id>
STORETIME_CONNECTION=<storetime-uc-connection>
OPSTASK_READ_CONNECTION=<opstask-read-uc-connection>
OPSTASK_WRITE_CONNECTION=<opstask-write-uc-connection>
CONFLUENCE_CONNECTION=<confluence-uc-connection>
# Optional workspace-governed route overrides:
# STORETIME_MCP_URL=https://<workspace-host>/api/2.0/mcp/external/<storetime-connection>
# OPSTASK_MCP_URL=https://<workspace-host>/api/2.0/mcp/external/<opstask-connection>
# CONFLUENCE_MCP_URL=https://<workspace-host>/api/2.0/mcp/external/<confluence-connection>
STORETIME_READ_TOOLS=<audited-read-tool-names>
OPSTASK_READ_TOOLS=<audited-lookup-tool-names>
CONFLUENCE_READ_TOOLS=<audited-retrieval-tool-names>
OPSTASK_CREATE_TOOL=<actual-task-write-tool>
# Semantic fields -> actual provider fields. Change the map, not application source.
OPSTASK_ARGUMENT_MAP={"title":"title","store_id":"store_id","assignee":"assignee","due_date":"due_date","idempotency_key":"idempotency_key"}
OPSTASK_RESULT_ID_FIELD=task_id
DATABRICKS_WORKFLOW_JOB_ID=<workflow-job-id>
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_ID=<experiment-id>
MLFLOW_TRACING_SQL_WAREHOUSE_ID=<sql-warehouse-id>
API_PROXY=http://localhost:8000/invocations
CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
# Credentials are supplied by the platform/local profile. Never commit tokens.

# Backend-only writer. App mode uses platform-injected DATABRICKS_CLIENT_ID/SECRET.
OPSTASK_WRITE_AUTH_MODE=app
OPSTASK_WRITE_OAUTH_SCOPES=<supported-backend-mcp-oauth-scopes>
# OPSTASK_WRITE_MCP_URL=https://<workspace-host>/api/2.0/mcp/external/<write-connection>
# For an explicitly configured dedicated backend identity instead:
# OPSTASK_WRITE_AUTH_MODE=m2m
# OPSTASK_WRITE_CLIENT_ID=<backend-service-principal-client-id>
# OPSTASK_WRITE_CLIENT_SECRET=<bind-with-server-side-secret-resource>
OPSTASK_APPROVAL_MODE=application
# Mode B, only after a supported Gateway policy is separately attached:
# OPSTASK_APPROVAL_MODE=application_and_gateway_ask
# OPSTASK_GATEWAY_POLICY_ID=<operator-selected-policy-id>
